+"""NEOFFICE FILE — Owned 100% by Neoservice. Not from upstream OpenConstructionERP.
+
+Remote embedding clients (Olares) — dense (OpenAI-compatible) and BGE-M3 hybrid.
+
+Rationale: OCE instances run on small boxes (4 GB RAM). Loading the embedding
+models locally (sentence-transformers/e5-small -> PyTorch ~1 GB for the general
+semantic search, BGE-M3 via FlagEmbedding ~1-2 GB for CWICR hybrid matching)
+saturates them. Olares already hosts these models on dedicated AI hardware, so
+we delegate ALL embedding to Olares over HTTP and keep zero ML weight on the
+instance. Two endpoints:
+
+* DENSE (general semantic search, ~30 modules): OpenAI-compatible
+  ``/v1/embeddings``, model ``qwen3-embedding:8b`` (4096-d). Endpoint already live.
+* HYBRID (CWICR cost matching): a dedicated BGE-M3 service returning dense
+  (1024-d) + sparse (lexical weights) in one call -> ``/embed`` (bge.noraai.ch).
+
+Everything is gated by Frappe site_config; when Olares is not configured the
+callers fall back to their previous local behaviour (dev machines).
+
+Used by:
+    * ``app.core.vector.get_embedder``        -> dense general semantic search
+    * ``app.modules.costs.qdrant_adapter``    -> CWICR hybrid (dense + sparse)
+"""
+
+from __future__ import annotations
+
+import json as _json
+import logging
+import os
+import threading
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+# Defaults (overridable via Frappe site_config keys, see _site_config below).
+_DEFAULT_DENSE_URL = "https://embeddings.noraai.ch/v1"
+_DEFAULT_DENSE_MODEL = "qwen3-embedding:8b"
+_DEFAULT_DENSE_DIM = 4096
+# No default for the BGE hybrid endpoint: it stays OFF until the operator sets
+# ``oce_olares_bge_url`` (so we never route CWICR to a not-yet-deployed service).
+
+_HTTP_TIMEOUT = 60.0  # embeddings can be slow on cold start / large batches
+_HTTP_RETRIES = 2
+
+_client_lock = threading.Lock()
+_http_client: Any = None
+
+
+def _site_config(key: str, default: Any = None) -> Any:
+    """Read a key from the Frappe site_config.json (same source as ai_client).
+
+    Kept local (not imported from ai_client) to avoid pulling that heavy module
+    into the vector hot path.
+    """
+    path = os.environ.get(
+        "FRAPPE_SITE_CONFIG",
+        "/home/neoffice/frappe-bench/sites/prod.local/site_config.json",
+    )
+    try:
+        with open(path) as f:
+            return _json.load(f).get(key, default)
+    except Exception:
+        return default
+
+
+def _truthy(value: Any) -> bool:
+    return str(value).strip().lower() in ("1", "true", "yes", "on")
+
+
+def _api_key() -> str | None:
+    key = _site_config("oce_olares_api_key")
+    return key if (key and str(key).strip()) else None
+
+
+def _http() -> Any:
+    """Shared httpx.Client (connection pooling, single instance per process)."""
+    global _http_client
+    if _http_client is not None:
+        return _http_client
+    with _client_lock:
+        if _http_client is None:
+            import httpx
+
+            _http_client = httpx.Client(timeout=_HTTP_TIMEOUT)
+    return _http_client
+
+
+def _post_json(url: str, payload: dict, api_key: str | None) -> dict:
+    """POST JSON with bearer auth + small retry on transient network errors."""
+    import httpx
+
+    headers = {"Content-Type": "application/json"}
+    if api_key:
+        headers["Authorization"] = f"Bearer {api_key}"
+    last_exc: Exception | None = None
+    for attempt in range(_HTTP_RETRIES + 1):
+        try:
+            resp = _http().post(url, json=payload, headers=headers)
+            resp.raise_for_status()
+            return resp.json()
+        except (httpx.TransportError, httpx.HTTPStatusError) as exc:
+            last_exc = exc
+            # 4xx (bad request / auth) is not worth retrying.
+            if isinstance(exc, httpx.HTTPStatusError) and exc.response.status_code < 500:
+                break
+    raise RuntimeError(f"Olares embeddings call failed ({url}): {last_exc}") from last_exc
+
+
+# ── DENSE (general semantic search) ──────────────────────────────────────────
+
+
+def olares_dense_enabled() -> bool:
+    """True when the general embedder should be served by Olares.
+
+    ON by default once an API key is present (the whole point is to offload the
+    model); set site_config ``oce_olares_embeddings=0`` to force the local model
+    (dev machines without Olares access).
+    """
+    if not _api_key():
+        return False
+    return _truthy(_site_config("oce_olares_embeddings", "1"))
+
+
+def dense_model_and_dim() -> tuple[str, int]:
+    model = _site_config("oce_olares_embeddings_model", _DEFAULT_DENSE_MODEL)
+    try:
+        dim = int(_site_config("oce_olares_embeddings_dim", _DEFAULT_DENSE_DIM))
+    except (TypeError, ValueError):
+        dim = _DEFAULT_DENSE_DIM
+    return model, dim
+
+
+class OlaresDenseEmbedder:
+    """Drop-in for the local sentence-transformers model used by
+    ``app.core.vector.encode_texts``.
+
+    ``encode_texts`` dispatches on ``hasattr(embedder, "embed")`` and calls
+    ``[v.tolist() for v in embedder.embed(texts)]`` — so we mirror FastEmbed's
+    interface: ``embed(texts)`` yields one numpy array per text. ``encode`` is
+    also provided for any caller using the sentence-transformers signature.
+    """
+
+    def __init__(self) -> None:
+        base = str(_site_config("oce_olares_embeddings_url", _DEFAULT_DENSE_URL)).rstrip("/")
+        self._url = base + "/embeddings"
+        self.model, self.dim = dense_model_and_dim()
+
+    def _embed_raw(self, texts: list[str]) -> list[list[float]]:
+        if not texts:
+            return []
+        data = _post_json(
+            self._url,
+            {"model": self.model, "input": list(texts)},
+            _api_key(),
+        )
+        # OpenAI-compatible: {"data": [{"embedding": [...], "index": i}, ...]}
+        rows = sorted(data.get("data", []), key=lambda r: r.get("index", 0))
+        return [r["embedding"] for r in rows]
+
+    def embed(self, texts: list[str], **_kwargs: Any):
+        import numpy as np
+
+        for vec in self._embed_raw(list(texts)):
+            yield np.asarray(vec, dtype="float32")
+
+    def encode(self, texts: list[str], **_kwargs: Any):
+        import numpy as np
+
+        return np.asarray(self._embed_raw(list(texts)), dtype="float32")
+
+
+# ── HYBRID (CWICR cost matching: dense + sparse) ─────────────────────────────
+
+
+def olares_bge_enabled() -> bool:
+    """True when the CWICR encoder should be served by the Olares BGE-M3 service.
+
+    OFF until the operator explicitly sets ``oce_olares_bge_url`` (so CWICR keeps
+    its current behaviour until the dedicated hybrid endpoint is live).
+    """
+    if not _api_key():
+        return False
+    url = _site_config("oce_olares_bge_url")
+    return bool(url and str(url).strip())
+
+
+class OlaresBGEM3Encoder:
+    """Drop-in for ``FlagEmbedding.BGEM3FlagModel`` as used by
+    ``qdrant_adapter._encode``.
+
+    The caller does:
+        out = encoder.encode(texts, return_dense=True, return_sparse=True,
+                             return_colbert_vecs=False)
+        out["dense_vecs"]       -> iterable of dense vectors
+        out["lexical_weights"]  -> list[dict[token_id -> weight]]
+
+    The Olares /embed service returns dense + sparse already split into
+    parallel indices/values lists; we rebuild ``lexical_weights`` so the
+    existing conversion to qdrant ``SparseVector`` keeps working unchanged.
+    """
+
+    def __init__(self) -> None:
+        base = str(_site_config("oce_olares_bge_url")).rstrip("/")
+        self._url = base + "/embed"
+
+    def encode(
+        self,
+        texts: list[str],
+        *,
+        return_dense: bool = True,
+        return_sparse: bool = True,
+        return_colbert_vecs: bool = False,
+        **_kwargs: Any,
+    ) -> dict[str, Any]:
+        texts = list(texts)
+        if not texts:
+            return {"dense_vecs": [], "lexical_weights": []}
+        data = _post_json(
+            self._url,
+            {
+                "input": texts,
+                "return_dense": return_dense,
+                "return_sparse": return_sparse,
+            },
+            _api_key(),
+        )
+        out: dict[str, Any] = {}
+        if return_dense:
+            out["dense_vecs"] = data.get("dense", [])
+        if return_sparse:
+            # service returns [{"indices": [int...], "values": [float...]}, ...]
+            # -> rebuild the dict[token_id -> weight] FlagEmbedding shape.
+            lexical: list[dict[int, float]] = []
+            for sp in data.get("sparse", []):
+                idx = sp.get("indices", []) or []
+                val = sp.get("values", []) or []
+                lexical.append({int(i): float(v) for i, v in zip(idx, val)})
+            out["lexical_weights"] = lexical
+        return out
